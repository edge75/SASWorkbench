<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SasWorkbench.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\SasWorkbench.Core\SasWorkbench.Core.csproj" />
  </ItemGroup>

  <!-- The ticket specimens the simulator's own tests read, so both ends are checked against one
       set of bytes rather than against each other's description of them. -->
  <ItemGroup>
    <None Include="..\..\fixtures\tickets\**" LinkBase="fixtures\tickets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
